# =============================================================================
# Retail Data Platform — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in actual values for your environment.
#   cp .env.example .env
#
# This file is safe to commit — it contains only placeholders.
# =============================================================================

# --- PostgreSQL (Airflow Metadata DB) ---
POSTGRES_USER=airflow
POSTGRES_PASSWORD=<CHANGE_ME>
POSTGRES_DB=airflow

# --- MinIO (S3-Compatible Object Storage) ---
MINIO_ROOT_USER=<CHANGE_ME>
MINIO_ROOT_PASSWORD=<CHANGE_ME>
MINIO_ENDPOINT=http://minio:9000
MINIO_ENDPOINT_EXTERNAL=http://localhost:9000

# --- Apache Airflow ---
AIRFLOW__CORE__EXECUTOR=LocalExecutor
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=<GENERATE_ME>
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW__API__SECRET_KEY=<GENERATE_ME>
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__LOGGING_LEVEL=INFO
AIRFLOW__WEBSERVER__WORKERS=2
AIRFLOW__WEBSERVER__WEB_SERVER_MASTER_TIMEOUT=300
AIRFLOW_WWW_USER_USERNAME=admin
AIRFLOW_WWW_USER_PASSWORD=<CHANGE_ME>

# --- Apache Kafka ---
KAFKA_BROKER_INTERNAL=kafka:29092
KAFKA_BROKER_EXTERNAL=localhost:9092

# --- Docker Image ---
IMAGE_NAME=myorg/retail-data-platform
