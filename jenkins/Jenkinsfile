pipeline {
    agent any

    environment {
        // Fallbacks for local testing without Jenkins credentials setup
        DOCKER_CREDS = 'dummy-docker-creds'
        IMAGE_NAME = 'retail-data-platform-test'
        MINIO_ACCESS_KEY = 'minioadmin'
        MINIO_SECRET_KEY = 'minioadmin'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Prepare Python') {
            steps {
                sh 'make ci-deps'
            }
        }

        stage('Lint & Format') {
            steps {
                sh 'make format-check lint'
            }
        }

        stage('Unit Tests') {
            steps {
                sh 'make test'
            }
        }

        stage('Build Image') {
            when {
                branch 'main'
            }
            steps {
                sh "docker build -t ${IMAGE_NAME}:${BUILD_NUMBER} -f docker/Dockerfile.airflow ."
            }
        }

        stage('Deploy Local') {
            when {
                branch 'main'
            }
            steps {
                withCredentials([
                    string(credentialsId: 'POSTGRES_PASSWORD', variable: 'POSTGRES_PASSWORD'),
                    string(credentialsId: 'MINIO_ROOT_PASSWORD', variable: 'MINIO_ROOT_PASSWORD'),
                    string(credentialsId: 'AIRFLOW__CORE__FERNET_KEY', variable: 'AIRFLOW__CORE__FERNET_KEY'),
                    string(credentialsId: 'AIRFLOW__API__SECRET_KEY', variable: 'AIRFLOW__API__SECRET_KEY'),
                    string(credentialsId: 'AIRFLOW_WWW_USER_USERNAME', variable: 'AIRFLOW_WWW_USER_USERNAME'),
                    string(credentialsId: 'AIRFLOW_WWW_USER_PASSWORD', variable: 'AIRFLOW_WWW_USER_PASSWORD')
                ]) {
                    sh '''
                    cat > .env <<EOF
                    POSTGRES_USER=airflow
                    POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
                    POSTGRES_DB=airflow
                    MINIO_ROOT_USER=minioadmin
                    MINIO_ROOT_PASSWORD=${MINIO_ROOT_PASSWORD}
                    MINIO_ENDPOINT=http://minio:9000
                    MINIO_ENDPOINT_EXTERNAL=http://localhost:9000
                    AIRFLOW__CORE__EXECUTOR=LocalExecutor
                    AIRFLOW__CORE__FERNET_KEY=${AIRFLOW__CORE__FERNET_KEY}
                    AIRFLOW__API__SECRET_KEY=${AIRFLOW__API__SECRET_KEY}
                    AIRFLOW__CORE__LOAD_EXAMPLES=False
                    AIRFLOW__CORE__LOGGING_LEVEL=INFO
                    AIRFLOW__WEBSERVER__WORKERS=2
                    AIRFLOW__WEBSERVER__WEB_SERVER_MASTER_TIMEOUT=300
                    AIRFLOW_WWW_USER_USERNAME=${AIRFLOW_WWW_USER_USERNAME}
                    AIRFLOW_WWW_USER_PASSWORD=${AIRFLOW_WWW_USER_PASSWORD}
                    EOF
                    docker compose --env-file .env up -d
                    '''
                }
            }
        }

        stage('Smoke Tests') {
            when {
                branch 'main'
            }
            steps {
                sh 'sleep 30'
                sh 'curl -f http://localhost:8085/health || exit 1'
                sh 'curl -f http://localhost:9000/minio/health/live || exit 1'
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo 'Pipeline executed successfully.'
        }
        failure {
            echo 'Pipeline failed!'
        }
    }
}
