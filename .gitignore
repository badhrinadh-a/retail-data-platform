# =============================================================================
# Retail Data Platform — .gitignore
# =============================================================================

# --- Secrets & Environment ---
.env
.env.local
.env.*.local

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.eggs/

# --- Virtual Environment (never commit; use .venv via make install-dev) ---
venv/
.venv/
env/
ENV/
*.venv/

# --- Test / tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
# --- IDE ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db

# --- Data & Logs ---
data/
*.log
logs/

# --- Docker ---
docker-compose.override.yml
